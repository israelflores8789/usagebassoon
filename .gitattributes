# Set default behavior to automatically normalize all text files to LF on check-in
* text=auto eol=lf

# Explicitly force LF for specific language files
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
Containerfile* text eol=lf
Dockerfile* text eol=lf

# Keep any compiled or binary files safe from text adjustments
*.png binary
*.jpg binary
*.pyc binary